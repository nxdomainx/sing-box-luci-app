config main 'main'
	option enabled '0'
	option sub_url ''
	option auto_update '0'
	option log_level ''
	option tun_stack 'system'
	option tun_mtu ''
	option hijack_lan_dns '1'
	option lan_dns6 '0'
	option dns_direct 'auto'
	option dns_listen_port '5335'
	option dashboard '1'
	option api_port '9091'
	option api_secret ''
	option dashboard_host 'dash.nxsb.arpa'
	option dashboard_ip '10.255.255.254'
	option mirror ''
	option core_channel 'pinned'
	option bbr '1'
