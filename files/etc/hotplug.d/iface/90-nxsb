#!/bin/sh
# nxsb: when a WAN-side interface comes up (or its DNS changes) the ISP resolver used as the LAN DNS fallback may
# only be known now (boot, PPPoE reconnect, ISP change). The init rewrites its dnsmasq drop-in only if it differs.
[ "$ACTION" = ifup ] || [ "$ACTION" = ifupdate ] || exit 0
case "$INTERFACE" in lan|loopback) exit 0;; esac
[ -x /etc/init.d/nxsb ] && /etc/init.d/nxsb hijack_refresh >/dev/null 2>&1
exit 0
