#!/bin/sh
[ -n "${IPKG_INSTROOT}" ] && exit 0
# opkg calls this with "remove" even for --force-reinstall and reports PKG_UPGRADE=0 there, so the
# signal cannot tell a real removal from a reinstall/upgrade. Park the core and the data instead;
# a postinst that runs within the grace period reclaims them, otherwise they are deleted.
KEEP=/usr/bin/.nxsb-core.keep
[ -x /usr/bin/nxsb ] && mv -f /usr/bin/nxsb $KEEP
rm -f /usr/bin/nxsb.new /usr/bin/nxsb.prev /tmp/hosts/nxsb-bootstrap
rm -rf /var/run/nxsb
[ -f /etc/crontabs/root ] && sed -i '\#/usr/lib/nxsb/autoupdate.sh#d' /etc/crontabs/root
rm -f /tmp/luci-indexcache /tmp/luci-modulecache/* 2>/dev/null
/etc/init.d/rpcd reload >/dev/null 2>&1
rm -f /tmp/dnsmasq.d/nxsb*.conf /tmp/dnsmasq.*.d/nxsb*.conf 2>/dev/null; nft delete table inet nxsb 2>/dev/null
[ -n "$(pidof dnsmasq)" ] && /etc/init.d/dnsmasq restart >/dev/null 2>&1
fw4 reload >/dev/null 2>&1

# Router settings this package changed go back the way they were, right now (a reinstall's postinst re-applies
# them; done synchronously so a reboot inside the grace period cannot lose it).
# IPv6 DNS advertisement (see dns6.sh):
DNS6="$(uci -q get nxsb.main.dns6_saved)"
for e in $DNS6; do s="${e%%:*}"; e="${e#*:}"; r="${e%%:*}"; d="${e#*:}"
	if [ -n "$r" ]; then uci set dhcp.$s.ra_dns="$r"; else uci -q delete dhcp.$s.ra_dns; fi
	if [ -n "$d" ]; then uci set dhcp.$s.dns_service="$d"; else uci -q delete dhcp.$s.dns_service; fi
done
[ -n "$DNS6" ] && { uci commit dhcp; /etc/init.d/odhcpd reload >/dev/null 2>&1; }
# congestion control: back to what it was. kmod-tcp-bbr fetched by this app carries its own sysctl file that
# would re-select bbr at the next boot, so on a real removal that package goes too (after the grace period,
# once opkg has released its lock); a kmod-tcp-bbr the user installed themselves stays.
rm -f /etc/sysctl.d/99-nxsb-bbr.conf /etc/modules.d/99-nxsb-bbr
CC="$(uci -q get nxsb.main.bbr_saved)"
[ -n "$CC" ] && { sysctl -w net.ipv4.tcp_congestion_control="$CC" >/dev/null 2>&1 || ( echo "$CC" > /proc/sys/net/ipv4/tcp_congestion_control ) 2>/dev/null; }
OURS_BBR=0; [ -f /etc/nxsb/kmod-tcp-bbr.installed-by-nxsb ] && [ "$CC" != bbr ] && OURS_BBR=1

# Real removal: the parked core (75 MB), the working directory and an app-installed kmod-tcp-bbr are removed once
# the grace period is over. If the router reboots before that, the same cleanup runs at the next boot instead.
cat > /etc/uci-defaults/zz-nxsb-cleanup <<EOF
[ -x /usr/lib/nxsb/core.sh ] && exit 0
rm -f $KEEP; rm -rf /etc/nxsb
[ $OURS_BBR = 1 ] && opkg remove kmod-tcp-bbr >/dev/null 2>&1
logger -t nxsb "removed: cleanup done at boot"
exit 0
EOF
( sleep 120; [ -x /usr/lib/nxsb/core.sh ] && exit 0
	rm -f $KEEP; rm -rf /etc/nxsb; rm -f /etc/uci-defaults/zz-nxsb-cleanup
	if [ $OURS_BBR = 1 ]; then opkg remove kmod-tcp-bbr >/dev/null 2>&1 && logger -t nxsb "removed: kmod-tcp-bbr (installed by this app) removed, congestion control back to $CC" || logger -t nxsb "removed: could not remove kmod-tcp-bbr (opkg busy?); /etc/sysctl.d/12-tcp-bbr.conf will re-select bbr at boot"; fi
	logger -t nxsb "removed: parked core and /etc/nxsb deleted" ) >/dev/null 2>&1 </dev/null &
exit 0
